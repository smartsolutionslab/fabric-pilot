{
  "realm": "fabric-pilot",
  "enabled": true,
  "registrationAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@example.com",
    "fromDisplayName": "fabric-pilot",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      { "name": "manager", "description": "Sample role: each module's sample policy <module>.manage requires it." }
    ]
  },
  "groups": [
    { "name": "tenants", "subGroups": [ { "name": "tenant-a" }, { "name": "tenant-b" } ] }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"department\",\"displayName\":\"Department\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "fabric-pilot-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "fabric-pilot-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fabric-pilot-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "developer", "temporary": false }],
      "realmRoles": ["manager"],
      "attributes": { "department": ["finance"] },
      "groups": ["/tenants/tenant-a"]
    },
    {
      "username": "developer-b",
      "enabled": true,
      "email": "developer-b@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer B",
      "credentials": [{ "type": "password", "value": "developer-b", "temporary": false }],
      "realmRoles": ["manager"],
      "attributes": { "department": ["finance"] },
      "groups": ["/tenants/tenant-b"]
    },
    {
      "username": "visitor",
      "enabled": true,
      "email": "visitor@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Visitor",
      "credentials": [{ "type": "password", "value": "visitor", "temporary": false }],
      "groups": ["/tenants/tenant-a"]
    },
    {
      "username": "clerk",
      "enabled": true,
      "email": "clerk@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Clerk",
      "credentials": [{ "type": "password", "value": "clerk", "temporary": false }],
      "realmRoles": ["manager"],
      "attributes": { "department": ["sales"] },
      "groups": ["/tenants/tenant-a"]
    },
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Analyst",
      "credentials": [{ "type": "password", "value": "analyst", "temporary": false }],
      "attributes": { "department": ["finance"] },
      "groups": ["/tenants/tenant-a"]
    }
  ]
}
