<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FabricPilot.AppHost</RootNamespace>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- Aspire keeps generated passwords here; without it a data volume outlives the password it was created with. -->
    <UserSecretsId>fabric-fabric-pilot-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MigrationRunner/MigrationRunner.csproj" />
    <ProjectReference Include="../Host/Host.csproj" />
  </ItemGroup>

</Project>
