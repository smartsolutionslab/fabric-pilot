# The SPA and its /api, as the Vite dev server serves them locally: /api/<path> goes to the host as /<path>.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # A ticket takes up to 5 attachments of 10 MB each (Tickets.Api's LargestRequest).
    client_max_body_size 51m;

    location /api/ {
        proxy_pass ${HOST_URL}/;
        # The host's internal ingress routes by name and serves TLS for it.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Built assets carry a content hash in their names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other path is a client route: answer index.html, never cached, so a deploy reaches the next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
