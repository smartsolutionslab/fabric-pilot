<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FabricPilot.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <!-- Reads the text back out of the invoice PDFs the host answers with. -->
    <PackageReference Include="PdfPig" />
    <!-- Publishes tickets' integration events onto the AppHost's broker in Wolverine's own format: no use case publishes them yet. -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AppHost/AppHost.csproj" />
    <!-- The contracts tests record contracts through the module's DbContext: no use case records one yet. -->
    <ProjectReference Include="../../src/Modules/Contracts/Contracts.Infrastructure/Contracts.Infrastructure.csproj" />
    <!-- The billing tests record invoices through the module's DbContext: no use case issues one yet. -->
    <ProjectReference Include="../../src/Modules/Billing/Billing.Infrastructure/Billing.Infrastructure.csproj" />
    <!-- The knowledge tests search the shared index as a tenant's use case would, with the fake embeddings the host is given. -->
    <ProjectReference Include="../../src/Modules/Knowledge/Knowledge.Infrastructure/Knowledge.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Contracts/Contracts.csproj" />
    <Compile Include="../Fakes/FakeEmbeddingGenerator.cs" Link="Fakes/FakeEmbeddingGenerator.cs" />
    <Compile Include="../Fakes/FakeChatClient.cs" Link="Fakes/FakeChatClient.cs" />
  </ItemGroup>

</Project>
