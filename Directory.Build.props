<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- src/Kernel is available everywhere but the AppHost, which composes processes and needs none of it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kernel' And '$(MSBuildProjectName)' != 'AppHost'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Kernel/Kernel.csproj" />
    <Using Include="FabricPilot.Kernel" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/guards/BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kernel' And '$(MSBuildProjectName)' != 'AppHost'">
    <Using Include="FabricPilot.Kernel.Result" Static="true" />
  </ItemGroup>
</Project>
